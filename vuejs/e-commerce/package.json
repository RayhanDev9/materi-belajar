    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.2",
    "axios": "^1.20.0",
    "json-server": "^1.0.0-beta.15",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^4.0.13"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
